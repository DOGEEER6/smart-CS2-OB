@echo off
chcp 65001 >nul
cd /d "%~dp0"
title CS2 导播副驾 - 设置界面（改按键 / 开回放 / 看内存）
echo ==========================================================
echo   CS2 导播副驾  --  图形设置界面
echo ==========================================================
echo.
echo   双击「开始导播.exe」也是打开这个窗口。
echo.
echo   在这里可以:
echo     - 改按键（点「修改」，然后按一下你要用的键；没小键盘的键盘改成 F8 之类）
echo     - 开关「回放功能」（默认关；关着的时候插件不占内存）
echo     - 选内存模式（省内存 = 按入点键才开始攒帧，裁完就释放）
echo     - 看这台机器上回放插件会占多少内存
echo.
echo   关掉这个窗口不影响导播；导播要单独点窗口里的「启动引擎」。
echo ==========================================================
echo.
python replay_director.py --gui --config config.json
if errorlevel 2 (
  echo.
  echo ！！这台电脑没有 tkinter，打不开图形界面。
  echo ！！命令行用法见「使用说明.md」，或直接双击 6-director.cmd 开跑。
)
pause
